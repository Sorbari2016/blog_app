<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%=title %></title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/layout.css">
  </head>
  <body>
    <form action="/articles/<%=article.id %>/edit" method="post">
      <h2>Edit Article</h2>
      <div class="form-item">
        <label for="title"
          ><span>* </span>Title
          <input
            type="text"
            value="<%=article.title %>"
            id="title"
            name="title"
            required
          />
        </label>
      </div>
      <div class="form-item">
        <label for="content"
          ><span>* </span>Content
          <textarea name="content" id="content" required></textarea>
        </label>
      </div>
       
      <% if (locals.message) { %>
        <div class="error-message">
          <small><%= message %></small>
        </div>
      <% } %>

      <div class="form-actions">
        <a href="/" class="cancel-btn">Go back</a>
        <button type="submit">Save chnages</button>
      </div>
    </form>

    <script>
      document.getElementById("content").value = "<%=article.content %>";
    </script>
  </body>
</html>

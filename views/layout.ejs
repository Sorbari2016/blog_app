<!DOCTYPE html>
<html lang="en">
<head>
  <title>Blog App Project</title>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/styles/layout.css">
</head>
<body>
    <div class="container">
      <!-- Header -->
      <%- include('partials/header') %>

      <!-- Sidebar -->
      <div class="main-container">
        <aside class="sidebar">
          <%- include('partials/sidebar') %>
        </aside>
          <!-- Main content (each page injects here) -->
          <main id="main-content">
            <header class="dashboard-header">
              <div>
                  <p>Hello <strong>username</strong> or anonymous</p>
                  <p class="muted">All articles written by user, from latest to oldest</p>
              </div>
              <%
              const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
              const months = [
                'January',
                "February",
                "March",
                "April",
                "May",
                "June",
                "July",
                "August",
                "September",
                "October",
                "November",
                "December"
              ]
              const now = new Date();
              const todayDate = `${now.getFullYear()}-${now.getMonth() + 1}-${now.getDate()}`
              const today = days[now.getDay()]
              const todayString = `${now.getDate()} ${months[now.getMonth()]}, ${now.getFullYear()}`
              %>
              <time datetime="<%= todayDate %>">
              <%=today  %>
              <br>
              <%=todayString %>
              </time>
            </header>
            <% if (locals.articles && locals.articles.length > 0) { %>  
                <section class="articles-overview">
                   <h2 class="sr-only">Your articles</h2>
                  <% articles.forEach(article => { %>
                   <div class="article-list">
                      <article class="article-card">
                        <h3><%= article.title %></h3>
                        <small><%= article.content.length %></small>
                        <p><%=article.content %></p>
                        <button aria-label="Article options">⋯</button>
                      </article>
                   </div>
                </section>
                <% }); %>
            <% }  else { %> 
                <p>No Articles yet...</p>
            <% }%>

            <section class="cta-write">
              <h2>Ready to write some stories today?</h2>
              <button class="primary">
               <a href="/articles">Write a story</a>
              </button>
              <p class="muted">
                Background picture of someone writing or pencil
              </p>
            </section>
            <section class="featured-articles">
              <h2>Featured articles</h2>
            <% features.forEach(article => { %>
              <article class="featured-card">
                <header>
                  <h3><%=article.title %> </h3>
                </header>
                <main>
                    <p><%=article.content %></p>
                </main>
                <footer>
                    <button aria-label="Edit article">
                      <a href="/articles/<%=article.id %>/edit">🖉</a>
                    </button>
                    <form action="/articles/<%=article.id %>/delete">
                        <button aria-label="Delete article">🗑
                        </button>
                    </form>
                    <time datetime="<%=article.updatedAt %>" class="updated">
                      <%=article.updatedAt.toDateString() %>
                    </time>
                </footer>
              </article>
           <%  }); %>
            </section>
          </main>
      </div>

      <!-- Footer -->
        <%- include('partials/footer') %>
    </div>
</body>
</html>
